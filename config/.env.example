# ==============================================================================
# LolAnalyzer Database Configuration Template
# ==============================================================================

# Database Engine Selection ('postgresql' or 'sqlite')
DB_ENGINE=postgresql

# PostgreSQL Connection Settings
POSTGRES_USER=lol_admin
POSTGRES_PASSWORD=lol_secure_password_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lol_analyzer_db

# Complete Connection URLs (Leave blank to auto-assemble from above parameters)
# Sync URL for Alembic migrations, DDL scripts, and administrative CLI utilities
DATABASE_URL=postgresql://lol_admin:lol_secure_password_2026@localhost:5432/lol_analyzer_db
# Async URL for asynchronous engines (FastAPI backend / asyncpg)
ASYNC_DATABASE_URL=postgresql+asyncpg://lol_admin:lol_secure_password_2026@localhost:5432/lol_analyzer_db

# SQLite Fallback (Used when DB_ENGINE=sqlite or DATABASE_URL is empty)
SQLITE_DB_PATH=./lol_analyzer.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# pgAdmin 4 Configuration (for docker-compose local environment)
PGADMIN_DEFAULT_EMAIL=admin@lolanalyzer.local
PGADMIN_DEFAULT_PASSWORD=admin_super_secret_pass
PGADMIN_PORT=5050
