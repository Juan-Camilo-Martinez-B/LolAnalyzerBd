[sqlfluff]
dialect = postgres
max_line_length = 160
exclude_rules = LT01,LT02,LT03,LT04,LT05,LT06,LT08,LT12,CP01,CP02,CP03,ST06,AM04,RF02,RF04,AL01,AL02,AL03

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper
